{
  "name": "daedalus",
  "version": "0.32.0-beta.6",
  "license": "FSL-1.1-MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "build": "bun run build:packages && bun run build:cli && bun run build:desktop",
    "build:packages": "bun build packages/core/src/index.ts packages/platform/src/index.ts packages/protocol/src/index.ts --outdir dist/packages --target bun",
    "build:cli": "bun build apps/cli/src/index.ts --outdir dist/cli --target bun",
    "build:desktop": "bun run build:tmux && bun run --cwd apps/desktop build && bun node_modules/.bin/electrobun build",
    "build:stable": "bun run build:packages && bun run build:cli && bun run build:tmux && bun run --cwd apps/desktop build && bun node_modules/.bin/electrobun build --env=stable && bun run scripts/name-release-dmg.ts",
    "build:tmux": "bun run scripts/build-tmux.ts",
    "app:install": "bun run build:stable && bun run scripts/install-app.ts",
    "dev": "bun run --cwd apps/desktop build && bun node_modules/.bin/electrobun dev --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "bun run scripts/typecheck.ts",
    "test": "bun test",
    "test:agent-tmux": "bun run scripts/agent-tmux-check.ts",
    "test:cli-agent": "bun run scripts/cli-agent-check.ts",
    "test:remote": "bun run scripts/remote-check.ts",
    "test:phone-ui": "bun run scripts/phone-ui-check.ts",
    "relay-admin": "bun run scripts/relay-admin.ts",
    "test:terminal-agent": "bun run scripts/terminal-agent-check.ts",
    "test:panels": "bun run scripts/panel-browser-check.ts",
    "test:settings-ui": "bun run scripts/settings-ui-check.ts",
    "test:reorder-ui": "bun run scripts/reorder-ui-check.ts",
    "test:repo-tree-ui": "bun run scripts/repo-tree-ui-check.tsx",
    "test:explorer-ui": "bun run scripts/explorer-ui-check.ts",
    "test:repo-picker-ui": "bun run scripts/repo-picker-ui-check.ts",
    "test:status-ui": "bun run scripts/status-ui-check.ts",
    "test:board-ui": "bun run scripts/board-ui-check.ts",
    "test:cloud-settings-ui": "bun run scripts/cloud-settings-ui-check.ts",
    "test:cloud-workspace-ui": "bun run scripts/cloud-workspace-ui-check.ts",
    "test:cloud-archive-ui": "bun run scripts/cloud-archive-ui-check.ts",
    "test:cloud-move-ui": "bun run scripts/cloud-move-ui-check.ts",
    "test:cloud-gateway-ui": "bun run scripts/cloud-gateway-ui-check.ts",
    "test:pins-ui": "bun run scripts/pins-ui-check.ts",
    "test:cloud-dialog-ui": "bun run scripts/cloud-dialog-ui-check.ts",
    "test:cloud-cards-ui": "bun run scripts/cloud-cards-ui-check.ts",
    "test:cloud-signin-ui": "bun run scripts/cloud-signin-ui-check.ts",
    "test:sidebar-ui": "bun run scripts/sidebar-ui-check.ts",
    "test:session-focus": "bun run scripts/session-focus-check.ts",
    "test:status-native": "bun run scripts/status-native-check.ts",
    "typecheck": "bun run scripts/typecheck.ts",
    "verify:versions": "bun run scripts/verify-versions.ts",
    "daedal": "bun run apps/cli/src/index.ts"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electrobun": "2.0.4",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
